{
  "name": "@anunnakicosmocrew/handlebars",
  "version": "0.1.0",
  "description": "With Handlebars theory core — pure-TS music theory: chords, scales, tunings, spelling, fretboard math",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "tonal": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnunnakiCosmoCrew/with-handlebars.git"
  },
  "author": "Anunnaki Cosmo Crew"
}
